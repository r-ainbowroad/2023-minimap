{
  "name": "r/place MLP Minimap",
  "author": "r/place MLP Minimap Authors",
  "description": "Minimap overlay and automatic selection of pixel + color for r/place",
  "namespace": "https://place.equestria.horse/",
  "grant": [
    "GM.xmlHttpRequest",
    "GM.getValue",
    "GM.setValue",
    "GM.addElement"
  ],
  "include": [
    "https://place.equestria.horse/*",
    "https://tyles.place/*"
  ],
  "downloadURL": "https://templates.brony.place/tyles/loader.user.js",
  "updateURL": "https://templates.brony.place/tyles/loader.user.js",
  "connect": [
    "raw.githubusercontent.com",
    "media.githubusercontent.com",
    "cdn.minimap.brony.place",
    "realtime.minimap.brony.place",
    "api.minimap.brony.place",
    "templates.brony.place"
  ],
  "version": "0.0.4"
}
